---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/sections/Hero.astro';
---

<BaseLayout
  title="Licenses"
  description="What ships with this theme, who made it, and what you may do with it."
>
  <Hero tag="Licenses" title="What ships with this theme, and on what terms" />
  <section class="global-section">
    <div class="w-layout-blockcontainer main-container w-container">
      <div class="utility-block">
        <div class="utility-summary" data-anim="hero">All graphical assets in this template are licensed for personal and commercial use. If you&#x27;d like to use a specific asset, please check the license below.</div>
        <div class="utility-wrapper">
          <div class="utility-card" data-anim="hero">
            <div class="utility-title-card">
              <div class="utility-name">Font</div>
              <p class="utility-except">A clean, versatile, and modern font designed for readability and professionalism, perfect for digital projects.</p>
            </div>
            <div class="utility-text-card">
              <div class="utility-text">
Libre Baskerville :                 <a class="utility-link" href="https://fonts.google.com/specimen/Libre+Baskerville" target="_blank">https://fonts.google.com/specimen/Libre+Baskerville</a>
              </div>
              <div class="utility-text">
Manrope :                 <a class="utility-link" href="https://fonts.google.com/specimen/Manrope" target="_blank">https://fonts.google.com/specimen/Manrope</a>
              </div>
            </div>
          </div>
          <div class="utility-card" data-anim="text-lines">
            <div class="utility-title-card">
              <div class="utility-name">Images</div>
              <p class="utility-except">A leading platform offering a wide variety of high-quality free images, vectors, and illustrations for creative use.</p>
            </div>
            <div class="utility-text-card">
              <div class="utility-text">
Freepik :                 <a class="utility-link" href="https://www.freepik.com" target="_blank">https://www.freepik.com</a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
