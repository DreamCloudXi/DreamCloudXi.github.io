---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/sections/Hero.astro';
---

<BaseLayout
  title="Privacy policy"
  description="How Handspark collects, uses and protects the information you share with the studio."
>
  <Hero tag="Privacy policy" title="What we keep, and for how long" />
  <section class="global-section">
    <div class="w-layout-blockcontainer main-container w-container">
      <div class="privacy-block">
        <div class="privacy-title-block">
          <h2 class="privacy-title is-display-show-for-desktop" data-anim="hero">At HandSpark we respect your privacy</h2>
          <h3 class="privacy-title is-display-show-for-mobile" data-anim="hero">At HandSpark we respect your privacy</h3>
        </div>
        <div class="privacy-card-block">
          <div class="privacy-card" data-anim="hero">
            <div class="privacy-name">Information We Collect</div>
            <div class="privacy-text">We may collect the following types of information:</div>
            <ul class="privacy-list" role="list">
              <li class="privacy-item">Personal Information: Name, email address, phone number, billing &amp; shipping address</li>
              <li class="privacy-item">Account Information: Login credentials, purchase history, preferences</li>
              <li class="privacy-item">Payment Information: Credit/debit card details (processed securely through third-party payment providers)</li>
              <li class="privacy-item">Usage Data: IP address, browser type, pages visited, and interactions with our website</li>
            </ul>
          </div>
          <div class="privacy-card" data-anim="text-lines">
            <div class="privacy-name">How We Use Your Information</div>
            <div class="privacy-text">We use the information we collect for:</div>
            <ul class="privacy-list" role="list">
              <li class="privacy-item">Processing orders, payments, and shipping</li>
              <li class="privacy-item">Improving our website, products, and services</li>
              <li class="privacy-item">Sending promotional emails, newsletters, and offers (you can unsubscribe at any time)</li>
              <li class="privacy-item">Responding to inquiries and customer support requests</li>
              <li class="privacy-item">Protecting against fraud, unauthorized transactions, and illegal activity</li>
            </ul>
          </div>
          <div class="privacy-card" data-anim="text-lines">
            <div class="privacy-name">Sharing Your Information</div>
            <div class="privacy-text">We do not sell or trade your personal data. Your information may be shared only with:</div>
            <ul class="privacy-list" role="list">
              <li class="privacy-item">Service Providers: Payment processors, shipping companies, and technical support providers</li>
              <li class="privacy-item">Legal Requirements: When required by law or to protect our rights and safety</li>
            </ul>
          </div>
          <div class="privacy-card" data-anim="text-lines">
            <div class="privacy-name">Cookies &amp; Tracking</div>
            <div class="privacy-text">We use cookies and similar technologies to:</div>
            <ul class="privacy-list" role="list">
              <li class="privacy-item">Improve site performance and usability</li>
              <li class="privacy-item">Analyze visitor behavior to enhance user experience</li>
              <li class="privacy-item">Display personalized content and promotions</li>
            </ul>
          </div>
          <div class="privacy-card" data-anim="text-lines">
            <div class="privacy-name">Security of Your Information</div>
            <div class="privacy-text">We implement industry-standard measures to protect your data, including:</div>
            <ul class="privacy-list" role="list">
              <li class="privacy-item">Secure Socket Layer (SSL) encryption for online transactions</li>
              <li class="privacy-item">Secure servers with restricted access</li>
              <li class="privacy-item">Regular monitoring for unauthorized activity</li>
            </ul>
          </div>
          <div class="privacy-card" data-anim="text-lines">
            <div class="privacy-name">Your Rights</div>
            <div class="privacy-text">You have the right to:</div>
            <ul class="privacy-list" role="list">
              <li class="privacy-item">Access your personal information</li>
              <li class="privacy-item">Correct or update inaccurate data</li>
              <li class="privacy-item">Request deletion of your personal data (subject to legal or business obligations)</li>
              <li class="privacy-item">Opt-out of marketing communications</li>
            </ul>
          </div>
          <div class="privacy-card" data-anim="text-lines">
            <div class="privacy-name">Third-Party Links</div>
            <div class="privacy-text">Our website may contain links to third-party sites. We are not responsible for the privacy practices or content of those websites.</div>
          </div>
          <div class="privacy-card" data-anim="text-lines">
            <div class="privacy-name">Children’s Privacy</div>
            <div class="privacy-text">Our website is not intended for children under 13. We do not knowingly collect personal information from children.</div>
          </div>
          <div class="privacy-card" data-anim="text-lines">
            <div class="privacy-name">Changes to This Privacy Policy</div>
            <div class="privacy-text">We may update this policy from time to time. Changes will be posted on this page with an updated “Effective Date.”</div>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
