---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../config/site';
import Hero from '../components/sections/Hero.astro';
import Icon from '../components/ui/Icon.astro';
---
<BaseLayout title="联系 DreamCloudXi" description="联系 DreamCloudXi。">
  <Hero tag="联系我" title="如果你想说点什么，欢迎写信给我" />
  <section class="global-section"><div class="w-layout-blockcontainer main-container w-container"><div class="contact-block">
    <div class="contact-text-block"><div class="contact-card-block"><div class="contact-card"><Icon name="contact-02" class="contact-card-icon" /><div class="contact-card-wrap"><div class="contact-card-info">电子邮箱</div><div class="contact-card-text"><a href={`mailto:${SITE.contact.email}`}>{SITE.contact.email}</a></div></div></div><div class="contact-card"><Icon name="contact-01" class="contact-card-icon" /><div class="contact-card-wrap"><div class="contact-card-info">所在位置</div><div class="contact-card-text">{SITE.contact.address}</div></div></div><div class="contact-card"><Icon name="contact-04" class="contact-card-icon" /><div class="contact-card-wrap"><div class="contact-card-info">回复时间</div><div class="contact-card-text">{SITE.contact.hours}</div></div></div></div></div>
    <div class="contact-form-block"><div class="contact-form w-form"><div class="contact-title">给 DreamCloudXi 留言</div><form class="contact-wrap" name="contact" data-contact-form><div class="contact-grid"><div class="contact-wrapp"><label class="contact-text" for="name">你的称呼</label><input class="contact-field w-input" name="name" id="name" placeholder="怎么称呼你？" type="text" required /></div><div class="contact-wrapp"><label class="contact-text" for="email">你的邮箱</label><input class="contact-field w-input" name="email" id="email" placeholder="方便回复你的邮箱" type="email" required /></div></div><div class="contact-grid"><div class="contact-wrapp"><label class="contact-text" for="message">想说的话</label><textarea class="contact-field is-contact-area w-input" name="message" id="message" rows="7" placeholder="写下你的留言……" required></textarea></div></div><div class="contact-grid"><div class="contact-button"><button type="submit" class="button w-inline-block"><div class="button-bg"></div><div class="button-text">发送留言</div><div class="button-wrap is-form"><Icon name="arrow-up-right" class="button-icon" /><Icon name="arrow-up-right" class="button-icon" /></div></button></div></div></form><div class="contact-done w-form-done" role="status" data-form-success hidden><div class="contact-message">留言已收到，谢谢你。</div></div><div class="contact-error w-form-fail" role="alert" data-form-error hidden><div class="contact-message">发送失败，请直接发邮件联系我。</div></div></div></div>
  </div></div></section>
</BaseLayout>
