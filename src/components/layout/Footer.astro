---
import Icon from '../ui/Icon.astro';
import logo from '../../assets/images/secondary-logo.svg';
import { FOOTER_NAV, ROUTES, SITE } from '../../config/site';

/**
 * The footer, on every page.
 *
 * Three link columns and a newsletter sign-up sit in one three-column grid —
 * the call to action spans all three and the middle and right columns are
 * placed by `additions.css`, because the export attached that placement to
 * generated element ids rather than to a class. The bottom row is a second
 * grid reading left, center, right.
 */
const path = Astro.url.pathname;
const current = (href: string) => (path === href ? 'page' : undefined);
const year = new Date().getFullYear();
---

<footer class="footer-section">
  <div class="w-layout-blockcontainer main-container w-container">
    <div class="footer-block">
      <div class="footer-menu-block">
        <div class="footer-text-block">
          <a aria-label={SITE.name} href={ROUTES.home} class="footer-brand w-inline-block">
            <img src={logo.src} alt={SITE.name} class="footer-logo" loading="lazy" />
          </a>

          <div class="footer-except">
            <div class="footer-except-text">Bringing a handmade touch to life&rsquo;s simplest</div>
            <Icon name="smiley" class="footer-except-icon" />
            <div class="footer-except-text">joys :)</div>
          </div>

          <div class="footer-social">
            {
              SITE.social.map((profile) => (
                <a
                  aria-label={profile.label}
                  href={profile.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="footer-social-link w-inline-block"
                >
                  <Icon name={profile.icon} class="footer-social-icon" />
                </a>
              ))
            }
          </div>
        </div>

        <div class="footer-line-block">
          <div class="footer-line"></div>
        </div>

        <div class="footer-nav-block">
          {
            FOOTER_NAV.map((group) => (
              <div class="footer-nav">
                <div class="footer-nav-title">{group.title}</div>
                <div class="footer-nav-wrap">
                  {group.links.map((link) => (
                    <a
                      href={link.href}
                      aria-current={current(link.href)}
                      class:list={['footer-nav-link', path === link.href && 'is-current']}
                    >
                      {link.label}
                    </a>
                  ))}
                </div>
              </div>
            ))
          }

          <div class="footer-cta">
            <div class="footer-title">Subscribe to our Newsletter*</div>
            <div class="footer-form w-form">
              {/*
                No endpoint is configured, so the shared form handler validates
                the address and shows the thank-you in place. Point `action` at
                a list provider to make it real — see docs/forms.md.
              */}
              <form class="footer-form-block" name="newsletter" data-newsletter>
                <label for="footer-email" class="sr-only">Email address</label>
                <input
                  class="footer-field w-input"
                  maxlength="256"
                  name="email"
                  placeholder="Enter Your e-mail"
                  type="email"
                  id="footer-email"
                  required
                />
                <button type="submit" class="footer-link w-button" aria-label="Subscribe"></button>
              </form>
              <div class="footer-done-block w-form-done" role="status" data-newsletter-success hidden>
                <div class="footer-message">Thank you for your submission!</div>
              </div>
              <div class="footer-error-block w-form-fail" role="alert" data-newsletter-error hidden>
                <div class="footer-message">Oops! Something went wrong.</div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="footer-divider-block">
        <div class="footer-divider"></div>
      </div>

      <div class="footer-copy-block">
        <ul class="footer-copy-text" role="list">
          <li>Copyright &copy; {year} {SITE.name}</li>
        </ul>
        <ul class="footer-copy-text" role="list">
          {
            SITE.credit && (
              <li>
                {SITE.credit.prefix}{' '}
                <a
                  class="footer-copy-link"
                  href={SITE.credit.href}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  {SITE.credit.label}
                </a>
              </li>
            )
          }
        </ul>
        <ul class="footer-copy-text" role="list">
          <li>
            Powered by{' '}
            <a
              class="footer-copy-link"
              href="https://astro.build"
              target="_blank"
              rel="noopener noreferrer"
            >
              Astro
            </a>
          </li>
        </ul>
      </div>
    </div>
  </div>
</footer>
