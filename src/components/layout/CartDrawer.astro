---
import Icon from '../ui/Icon.astro';

/**
 * The cart button and the panel behind it.
 *
 * A static site has nowhere to keep a basket, so nothing here pretends to: the
 * count reads zero, the panel opens on its empty state, and the checkout button
 * is absent rather than being a link that charges nobody. Every element a cart
 * provider needs to write into carries a `data-cart-*` hook, so wiring Snipcart
 * or a Shopify Buy Button to it is markup-free — see `docs/commerce.md`.
 *
 * The design places this twice: in the desktop menu row, and again in the
 * mobile bar beside the menu toggle. `id` keeps the two apart for labelling.
 */
interface Props {
  id: string;
}

const { id } = Astro.props;
---

<div class="header-cart-block">
  <div class="header-cart" data-cart>
    <button
      type="button"
      class="header-cart-button w-inline-block"
      aria-expanded="false"
      aria-controls={`${id}-panel`}
      data-cart-toggle
    >
      <span class="header-cart-text w-inline-block">Cart</span>
      <Icon name="cart" class="header-cart-icon" />
      <span class="header-cart-num" data-cart-count>0</span>
    </button>

    <div class="header-cart-wrapp" id={`${id}-panel`} data-cart-panel>
      <div class="header-cart-wrap">
        <div class="header-cart-header">
          <h4 class="header-cart-title">Your Cart</h4>
          <button type="button" class="header-cart-close w-inline-block" aria-label="Close cart" data-cart-close>
            <Icon name="close" />
          </button>
        </div>

        <div class="header-cart-footer">
          {/* Hidden until a cart provider has lines to put in it. */}
          <div class="header-cart-default" data-cart-lines hidden>
            <div class="header-cart-list" data-cart-items></div>

            <div class="header-cart-link">
              <div class="header-cart-prices">
                <div>Subtotal</div>
                <div data-cart-total>&mdash;</div>
              </div>
            </div>
          </div>

          <div class="header-cart-empty" data-cart-empty>
            <div>Your cart is empty.</div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
